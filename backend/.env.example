# ==========================================
# Cấu hình Máy chủ (Application Server)
# ==========================================
NODE_ENV=development
PORT=5000

# ==========================================
# Cấu hình Cơ sở dữ liệu (MS SQL Server 2022)
# ==========================================
DB_HOST=localhost
DB_PORT=1433
DB_NAME=BookNestDB
DB_USER=booknest_user
DB_PASSWORD=your_db_password_here

# ==========================================
# Cấu hình Bảo mật JWT (JSON Web Token)
# ==========================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# ==========================================
# Cấu hình truy cập (không bắt buộc)
# ==========================================
# Nguồn gọi API tách riêng theo khu, có thể khai báo nhiều origin bằng dấu phẩy
CORS_STOREFRONT_ORIGIN=http://localhost:3000
CORS_BACKOFFICE_ORIGIN=http://localhost:5174
# Số lớp reverse proxy đứng trước server, để 0 nếu chạy trực tiếp
TRUST_PROXY=0

# ==========================================
# Cấu hình Cổng Thanh toán VietQR (payOS)
# Đăng ký và lấy khóa tại: https://my.payos.vn/
# ==========================================
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here

# ==========================================
# Cấu hình AI Chatbot Tư Vấn (T54 - Xoay tua Gemini & NVIDIA)
# 1. Gemini (Chính & Phụ): Tạo API Key tại https://aistudio.google.com/
# Model chính: gemini-3.1-flash-lite (hoặc cấu hình tùy chọn)
# Model phụ: để trống nếu chưa dùng, hoặc điền mã model Gemini thứ 2 để tăng hạn mức
# Giờ reset hạn mức ngày: 0 (UTC 0h tương đương 07:00 giờ Việt Nam)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_PHU=
GEMINI_GIO_RESET_UTC=0

# 2. NVIDIA NIM (Dự phòng khi Gemini hết hạn mức hoặc lỗi): https://build.nvidia.com/
AI_PROVIDER=nvidia
AI_API_KEY=your_nvidia_nim_api_key_here
AI_MODEL=meta/llama-3.2-11b-vision-instruct
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_CHATBOT_BAT=true

# ==========================================
# Cấu hình Dịch vụ Gửi Email (SMTP / Gmail)
# Tạo mật khẩu ứng dụng (App Password) tại: https://myaccount.google.com/apppasswords
# Để trống nếu muốn chạy chế độ Safe Dev Mode (hệ thống sẽ log mã OTP & email ra console mà không gây lỗi)
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="BookNest Bookstore <noreply@booknest.vn>"
# Đặt EMAIL_MOCK=true khi dev hoặc chạy test e2e để CHẶN gửi mail thật (tránh spam hòm thư, in log ra console)
# Đặt EMAIL_MOCK=false khi cần demo thực tế cho giảng viên xem email thật bay về hộp thư
EMAIL_MOCK=false

# ==========================================
# Cấu hình Lưu trữ Ảnh Bìa (Cloudinary)
# ==========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
