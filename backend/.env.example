# ==========================================
# Cấu hình Máy chủ (Application Server)
# ==========================================
NODE_ENV=development
PORT=5000

# ==========================================
# Cấu hình Cơ sở dữ liệu (MS SQL Server 2022)
# ==========================================
DB_HOST=localhost
DB_PORT=1433
DB_NAME=BookNestDB
DB_USER=booknest_user
DB_PASSWORD=your_db_password_here

# ==========================================
# Cấu hình Bảo mật JWT (JSON Web Token)
# ==========================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
