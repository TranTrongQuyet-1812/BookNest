# ==========================================
# Cấu hình Máy chủ (Application Server)
# ==========================================
NODE_ENV=development
PORT=5000

# ==========================================
# Cấu hình Cơ sở dữ liệu (MS SQL Server 2022)
# ==========================================
DB_HOST=localhost
DB_PORT=1433
DB_NAME=BookNestDB
DB_USER=booknest_user
DB_PASSWORD=your_db_password_here

# ==========================================
# Cấu hình Bảo mật JWT (JSON Web Token)
# ==========================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# ==========================================
# Cấu hình truy cập (không bắt buộc)
# ==========================================
# Nguồn gọi API tách riêng theo khu, có thể khai báo nhiều origin bằng dấu phẩy
CORS_STOREFRONT_ORIGIN=http://localhost:3000
CORS_BACKOFFICE_ORIGIN=http://localhost:5174
# Số lớp reverse proxy đứng trước server, để 0 nếu chạy trực tiếp
TRUST_PROXY=0

# ==========================================
# Cấu hình Cổng Thanh toán VietQR (payOS)
# Đăng ký và lấy khóa tại: https://my.payos.vn/
# ==========================================
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here

# ==========================================
# Cấu hình AI Chatbot Tư Vấn (NVIDIA NIM)
# Đăng ký và lấy khóa API tại: https://build.nvidia.com/
# Model tối ưu: meta/llama-3.2-11b-vision-instruct (chuẩn Function Calling & Tiếng Việt)
# ==========================================
AI_PROVIDER=nvidia
AI_API_KEY=your_nvidia_nim_api_key_here
AI_MODEL=meta/llama-3.2-11b-vision-instruct
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_CHATBOT_BAT=true
